<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <!-- SheetJS CDN untuk export Excel -->
    <script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>
    <style>
        /* Override default full-center layout for dashboard convenience */
        body {
            height: auto;
            min-height: 100vh;
            display: block;
            overflow-y: auto;
            padding: 40px 20px;
            background: radial-gradient(circle at top left, #1c1437, #0a0715);
        }

        .dashboard-wrapper {
            max-width: 1200px;
            margin: 0 auto;
            animation: fadeIn 0.6s cubic-bezier(0.16, 1, 0.3, 1);
        }

        .header-panel {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 30px;
            flex-wrap: wrap;
            gap: 20px;
        }

        .header-title h1 {
            margin-bottom: 5px;
            text-align: left;
            font-size: 2.2rem;
            letter-spacing: -0.5px;
        }

        .header-title p {
            margin-bottom: 0;
            text-align: left;
            font-size: 1rem;
            color: rgba(255, 255, 255, 0.6);
        }

        /* Metric Cards */
        .metrics-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 20px;
            margin-bottom: 30px;
        }

        .metric-card {
            background: rgba(255, 255, 255, 0.03);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border-radius: 16px;
            border: 1px solid rgba(255, 255, 255, 0.08);
            padding: 24px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
            position: relative;
            overflow: hidden;
            box-shadow: 0 4px 30px rgba(0, 0, 0, 0.2);
        }

        .metric-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(135deg, rgba(255, 255, 255, 0.05), transparent);
            pointer-events: none;
        }

        .metric-card:hover {
            transform: translateY(-5px);
            border-color: rgba(255, 0, 127, 0.25);
            box-shadow: 0 10px 30px rgba(255, 0, 127, 0.1);
        }

        .metric-info h3 {
            font-size: 0.9rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: rgba(255, 255, 255, 0.5);
            margin-bottom: 8px;
        }

        .metric-value {
            font-size: 2.5rem;
            font-weight: 800;
            line-height: 1;
            background: #fff;
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .metric-card.primary .metric-value {
            background: linear-gradient(to right, #ffffff, #ff007f);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .metric-card.bod-card .metric-value {
            background: linear-gradient(to right, #7f00ff, #e100ff);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .metric-card.staf-card .metric-value {
            background: linear-gradient(to right, #00c6ff, #0072ff);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .metric-icon {
            font-size: 2.2rem;
            padding: 15px;
            border-radius: 12px;
            background: rgba(255, 255, 255, 0.05);
        }

        .metric-card.primary .metric-icon {
            color: #ff007f;
            background: rgba(255, 0, 127, 0.1);
        }

        .metric-card.bod-card .metric-icon {
            color: #b800ff;
            background: rgba(127, 0, 255, 0.1);
        }

        .metric-card.staf-card .metric-icon {
            color: #00c6ff;
            background: rgba(0, 198, 255, 0.1);
        }

        /* Controls Panel */
        .table-controls {
            background: rgba(255, 255, 255, 0.03);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border-radius: 16px 16px 0 0;
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-bottom: none;
            padding: 20px 24px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 15px;
        }

        .search-box {
            position: relative;
            flex: 1;
            max-width: 400px;
            min-width: 250px;
        }

        .search-box i {
            position: absolute;
            left: 15px;
            top: 50%;
            transform: translateY(-50%);
            color: rgba(255, 255, 255, 0.4);
            font-size: 1rem;
        }

        .search-box input {
            padding-left: 45px;
            height: 44px;
        }

        .filter-actions {
            display: flex;
            gap: 12px;
            align-items: center;
            flex-wrap: wrap;
        }

        .filter-select {
            height: 44px;
            padding: 0 15px;
            width: auto;
            min-width: 150px;
            cursor: pointer;
        }

        .filter-select option {
            background-color: #1c1437;
            color: white;
        }

        .btn-export {
            margin-top: 0;
            height: 44px;
            padding: 0 20px;
            display: flex;
            align-items: center;
            gap: 8px;
            background: linear-gradient(135deg, #107c41, #1f9a55);
            font-weight: 500;
        }

        .btn-export:hover {
            box-shadow: 0 5px 15px rgba(24, 154, 85, 0.3);
            border-color: #1f9a55;
        }

        /* Table Design */
        .table-responsive {
            background: rgba(255, 255, 255, 0.03);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border-radius: 0 0 16px 16px;
            border: 1px solid rgba(255, 255, 255, 0.08);
            overflow: hidden;
            box-shadow: var(--shadow);
        }

        table {
            width: 100%;
            border-collapse: collapse;
            text-align: left;
        }

        th {
            background: rgba(255, 255, 255, 0.05);
            padding: 16px 24px;
            font-weight: 600;
            font-size: 0.9rem;
            color: rgba(255, 255, 255, 0.7);
            border-bottom: 1px solid rgba(255, 255, 255, 0.08);
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        td {
            padding: 16px 24px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.04);
            font-size: 0.95rem;
            color: rgba(255, 255, 255, 0.9);
            vertical-align: middle;
        }

        tr {
            transition: background-color 0.2s;
        }

        tr:hover {
            background-color: rgba(255, 255, 255, 0.02);
        }

        tr:last-child td {
            border-bottom: none;
        }

        /* Table Badges */
        .badge {
            display: inline-flex;
            align-items: center;
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 0.8rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.3px;
        }

        .badge.bod {
            background: rgba(127, 0, 255, 0.15);
            color: #d28cff;
            border: 1px solid rgba(127, 0, 255, 0.3);
        }

        .badge.staf {
            background: rgba(0, 198, 255, 0.15);
            color: #7ce7ff;
            border: 1px solid rgba(0, 198, 255, 0.3);
        }

        .divisi-badge {
            background: rgba(255, 255, 255, 0.05);
            color: rgba(255, 255, 255, 0.8);
            padding: 4px 10px;
            border-radius: 6px;
            font-size: 0.85rem;
            border: 1px solid rgba(255, 255, 255, 0.05);
        }

        /* Image preview thumbnail */
        .photo-thumbnail {
            width: 50px;
            height: 50px;
            border-radius: 50%;
            object-fit: cover;
            border: 2px solid rgba(255, 255, 255, 0.15);
            cursor: pointer;
            transition: all 0.2s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }

        .photo-thumbnail:hover {
            transform: scale(1.18);
            border-color: var(--primary-color);
            box-shadow: 0 0 10px rgba(255, 0, 127, 0.5);
        }

        .no-data {
            text-align: center;
            padding: 60px 0;
            color: rgba(255, 255, 255, 0.4);
            font-size: 1.1rem;
        }

        .no-data i {
            font-size: 3rem;
            margin-bottom: 15px;
            color: rgba(255, 255, 255, 0.2);
            display: block;
        }

        /* Action Buttons */
        .btn-delete {
            width: 36px;
            height: 36px;
            border-radius: 8px;
            background: rgba(255, 59, 48, 0.1);
            color: #ff3b30;
            border: 1px solid rgba(255, 59, 48, 0.2);
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.2s;
            margin-top: 0;
            padding: 0;
        }

        .btn-delete:hover {
            background: #ff3b30;
            color: white;
            transform: scale(1.05);
            box-shadow: 0 0 10px rgba(255, 59, 48, 0.4);
        }

        /* Lightbox Modal */
        .lightbox-modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(10, 7, 21, 0.95);
            z-index: 999;
            backdrop-filter: blur(15px);
            -webkit-backdrop-filter: blur(15px);
            align-items: center;
            justify-content: center;
            animation: fadeIn 0.3s ease;
        }

        .lightbox-content {
            position: relative;
            max-width: 90%;
            max-height: 80%;
            text-align: center;
        }

        .lightbox-img {
            max-width: 100%;
            max-height: 70vh;
            border-radius: 12px;
            border: 2px solid rgba(255, 255, 255, 0.1);
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.5);
            object-fit: contain;
        }

        .lightbox-close {
            position: absolute;
            top: -40px;
            right: 0;
            color: white;
            font-size: 1.8rem;
            cursor: pointer;
            background: none;
            border: none;
            width: auto;
            margin-top: 0;
            padding: 0;
            transition: opacity 0.2s;
        }

        .lightbox-close:hover {
            opacity: 0.8;
            box-shadow: none;
            transform: none;
        }

        .lightbox-info {
            margin-top: 15px;
            color: white;
            font-size: 1.2rem;
            font-weight: 600;
        }

        .lightbox-subinfo {
            color: rgba(255, 255, 255, 0.6);
            font-size: 0.95rem;
            margin-top: 5px;
        }

        /* Layout Grid */
        .layout-grid {
            display: grid;
            grid-template-columns: 8fr 4fr;
            gap: 24px;
            align-items: start;
        }

        .table-container-col {
            display: flex;
            flex-direction: column;
        }

        /* Division Manager Styling */
        .division-manager-card {
            background: rgba(255, 255, 255, 0.03);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border-radius: 16px;
            border: 1px solid rgba(255, 255, 255, 0.08);
            box-shadow: var(--shadow);
            padding: 24px;
            border-top: 3px solid var(--secondary-color);
        }

        .division-card-header h2 {
            font-size: 1.3rem;
            margin-bottom: 5px;
            background: linear-gradient(to right, #ffffff, #7f00ff);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .division-card-header p {
            margin-bottom: 20px;
            font-size: 0.85rem;
            color: rgba(255, 255, 255, 0.5);
            text-align: left;
        }

        .division-list {
            display: flex;
            flex-direction: column;
            gap: 8px;
            max-height: 300px;
            overflow-y: auto;
            padding-right: 5px;
            margin-top: 8px;
        }

        /* Custom Scrollbar for division list */
        .division-list::-webkit-scrollbar {
            width: 4px;
        }
        .division-list::-webkit-scrollbar-track {
            background: rgba(255, 255, 255, 0.02);
        }
        .division-list::-webkit-scrollbar-thumb {
            background: rgba(255, 255, 255, 0.1);
            border-radius: 2px;
        }
        .division-list::-webkit-scrollbar-thumb:hover {
            background: var(--secondary-color);
        }

        .division-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: rgba(255, 255, 255, 0.04);
            border: 1px solid rgba(255, 255, 255, 0.05);
            border-radius: 8px;
            padding: 10px 14px;
            transition: all 0.2s ease;
        }

        .division-item:hover {
            background: rgba(127, 0, 255, 0.05);
            border-color: rgba(127, 0, 255, 0.2);
            transform: translateX(2px);
        }

        .division-item .div-name {
            font-weight: 500;
            font-size: 0.95rem;
            color: rgba(255, 255, 255, 0.9);
        }

        .btn-delete-div {
            background: transparent;
            color: rgba(255, 255, 255, 0.4);
            border: none;
            cursor: pointer;
            width: auto;
            margin-top: 0;
            padding: 0;
            font-size: 0.9rem;
            transition: all 0.2s;
        }

        .btn-delete-div:hover {
            color: #ff3b30;
            transform: scale(1.2);
            box-shadow: none;
        }

        /* Responsive styling */
        @media (max-width: 992px) {
            .layout-grid {
                grid-template-columns: 1fr;
            }
        }

        @media (max-width: 768px) {
            .header-panel {
                flex-direction: column;
                align-items: flex-start;
            }
            .table-controls {
                flex-direction: column;
                align-items: stretch;
            }
            .search-box {
                max-width: 100%;
            }
            th, td {
                padding: 12px 16px;
            }
        }
    </style>
</head>

<body>
    <div class="dashboard-wrapper">
        <!-- Header -->
        <div class="header-panel">
            <div class="header-title">
                <h1>Dashboard Registrasi</h1>
                <p>Data Pengunjung Terdaftar & Foto Selfie Event SynchroMark</p>
            </div>
            <div>
                <a href="/7a2b" target="_blank" style="text-decoration: none; margin-right: 10px;">
                    <button class="back-btn" style="width: auto; display: inline-flex; align-items: center; gap: 8px; height: 44px; padding: 0 20px; font-weight: 500; font-size: 0.9rem; margin-top: 0;">
                        <i class="fas fa-qrcode"></i> QR BOD
                    </button>
                </a>
                <a href="/9f4c" target="_blank" style="text-decoration: none;">
                    <button class="back-btn" style="width: auto; display: inline-flex; align-items: center; gap: 8px; height: 44px; padding: 0 20px; font-weight: 500; font-size: 0.9rem; margin-top: 0;">
                        <i class="fas fa-qrcode"></i> QR Staf
                    </button>
                </a>
            </div>
        </div>

        <!-- Metrics cards -->
        <div class="metrics-grid">
            <div class="metric-card primary">
                <div class="metric-info">
                    <h3>Total Registrasi</h3>
                    <div class="metric-value" id="count-total"><%= submissions.length %></div>
                </div>
                <div class="metric-icon">
                    <i class="fas fa-users"></i>
                </div>
            </div>

            <div class="metric-card bod-card">
                <div class="metric-info">
                    <h3>Board of Directors</h3>
                    <div class="metric-value" id="count-bod">
                        <%= submissions.filter(s => s.userType === 'bod').length %>
                    </div>
                </div>
                <div class="metric-icon">
                    <i class="fas fa-crown"></i>
                </div>
            </div>

            <div class="metric-card staf-card">
                <div class="metric-info">
                    <h3>Staf / Guest</h3>
                    <div class="metric-value" id="count-staf">
                        <%= submissions.filter(s => s.userType === 'staf').length %>
                    </div>
                </div>
                <div class="metric-icon">
                    <i class="fas fa-user-tie"></i>
                </div>
            </div>
        </div>

        <!-- Main Layout Grid -->
        <div class="layout-grid">
            <!-- Left Side: Table Submissions -->
            <div class="table-container-col">
                <!-- Table Controls -->
                <div class="table-controls">
                    <div class="search-box">
                        <i class="fas fa-search"></i>
                        <input type="text" id="table-search" placeholder="Cari nama atau divisi...">
                    </div>

                    <div class="filter-actions">
                        <select id="table-filter" class="filter-select">
                            <option value="all">Semua Kategori</option>
                            <option value="bod">Board of Directors</option>
                            <option value="staf">Staf</option>
                        </select>

                        <button class="btn-export" onclick="exportToExcel()">
                            <i class="fas fa-file-excel"></i> Export Excel
                        </button>
                    </div>
                </div>

                <!-- Table Data -->
                <div class="table-responsive">
                    <table id="submissions-table">
                        <thead>
                            <tr>
                                <th style="width: 60px; text-align: center;">No</th>
                                <th style="width: 90px; text-align: center;">Foto</th>
                                <th>Nama Lengkap</th>
                                <th>Divisi</th>
                                <th>Kategori</th>
                                <th>Waktu Registrasi</th>
                                <th style="width: 80px; text-align: center;">Aksi</th>
                            </tr>
                        </thead>
                        <tbody id="table-body">
                            <% if (submissions.length === 0) { %>
                                <tr class="no-data-row">
                                    <td colspan="7">
                                        <div class="no-data">
                                            <i class="fas fa-folder-open"></i>
                                            Belum ada data pengunjung yang terdaftar.
                                        </div>
                                    </td>
                                </tr>
                            <% } else { %>
                                <% submissions.forEach((sub, index) => { %>
                                    <tr class="submission-row" data-id="<%= sub.id %>" data-type="<%= sub.userType %>" data-name="<%= sub.name.toLowerCase() %>" data-division="<%= sub.division.toLowerCase() %>">
                                        <td style="text-align: center; font-weight: 600; color: rgba(255,255,255,0.4);" class="row-number">
                                            <%= index + 1 %>
                                        </td>
                                        <td style="text-align: center;">
                                            <img src="<%= sub.imageUrl %>" alt="<%= sub.name %>" class="photo-thumbnail" 
                                                 onclick="openLightbox('<%= sub.imageUrl %>', '<%= sub.name %>', '<%= sub.division %>', '<%= sub.userType.toUpperCase() %>', '<%= new Date(sub.timestamp).toLocaleString('id-ID') %>')">
                                        </td>
                                        <td style="font-weight: 600;">
                                            <%= sub.name %>
                                        </td>
                                        <td>
                                            <span class="divisi-badge"><%= sub.division %></span>
                                        </td>
                                        <td>
                                            <span class="badge <%= sub.userType %>">
                                                <%= sub.userType === 'bod' ? 'BOD' : 'Staf' %>
                                            </span>
                                        </td>
                                        <td style="color: rgba(255, 255, 255, 0.6); font-size: 0.9rem;">
                                            <%= new Date(sub.timestamp).toLocaleString('id-ID', { dateStyle: 'medium', timeStyle: 'short' }) %>
                                        </td>
                                        <td style="text-align: center;">
                                            <button class="btn-delete" title="Hapus Data" onclick="deleteSubmission('<%= sub.id %>')">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </td>
                                    </tr>
                                <% }) %>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Right Side: Division Manager -->
            <div class="division-manager-col">
                <div class="division-manager-card">
                    <div class="division-card-header">
                        <h2><i class="fas fa-tags"></i> Kelola Divisi</h2>
                        <p>Tambah & hapus divisi dinamis untuk form</p>
                    </div>
                    <div class="division-card-body">
                        <!-- Add Division Form -->
                        <div class="form-group" style="margin-bottom: 15px;">
                            <label for="new-division-name">Nama Divisi Baru</label>
                            <div style="display: flex; gap: 8px;">
                                <input type="text" id="new-division-name" placeholder="Contoh: IT, HRD, Finance..." style="flex: 1; height: 44px; padding: 12px 15px;">
                                <button id="btn-add-division" onclick="addDivision()" style="margin-top: 0; width: auto; height: 44px; padding: 0 15px; display: inline-flex; align-items: center; justify-content: center;"><i class="fas fa-plus"></i></button>
                            </div>
                        </div>
                        
                        <!-- Division List -->
                        <label>Daftar Divisi Aktif</label>
                        <div class="division-list" id="division-list-container">
                            <% divisions.forEach(function(div) { %>
                                <div class="division-item" data-name="<%= div %>">
                                    <span class="div-name"><%= div %></span>
                                    <button class="btn-delete-div" title="Hapus Divisi" onclick="deleteDivision('<%= div %>')">
                                        <i class="fas fa-times"></i>
                                    </button>
                                </div>
                            <% }); %>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Lightbox Modal -->
    <div id="lightbox" class="lightbox-modal" onclick="closeLightbox()">
        <div class="lightbox-content" onclick="event.stopPropagation()">
            <button class="lightbox-close" onclick="closeLightbox()"><i class="fas fa-times"></i></button>
            <img id="lightbox-img" class="lightbox-img" src="" alt="Lightbox Preview">
            <div id="lightbox-name" class="lightbox-info"></div>
            <div id="lightbox-meta" class="lightbox-subinfo"></div>
        </div>
    </div>

    <script>
        // Real-time search and filtering logic
        const searchInput = document.getElementById('table-search');
        const filterSelect = document.getElementById('table-filter');
        const rows = document.querySelectorAll('.submission-row');
        const countTotal = document.getElementById('count-total');
        const countBod = document.getElementById('count-bod');
        const countStaf = document.getElementById('count-staf');

        function filterTable() {
            const query = searchInput.value.toLowerCase().trim();
            const filter = filterSelect.value;
            let visibleCount = 0;
            let visibleBod = 0;
            let visibleStaf = 0;

            rows.forEach((row, idx) => {
                const name = row.getAttribute('data-name');
                const division = row.getAttribute('data-division');
                const type = row.getAttribute('data-type');

                const matchesSearch = name.includes(query) || division.includes(query);
                const matchesFilter = filter === 'all' || type === filter;

                if (matchesSearch && matchesFilter) {
                    row.style.display = '';
                    visibleCount++;
                    if (type === 'bod') visibleBod++;
                    if (type === 'staf') visibleStaf++;
                } else {
                    row.style.display = 'none';
                }
            });

            // Re-index row numbers
            let shownIndex = 1;
            rows.forEach((row) => {
                if (row.style.display !== 'none') {
                    row.querySelector('.row-number').textContent = shownIndex++;
                }
            });

            // Update live counters based on search/filter results
            countTotal.textContent = visibleCount;
            countBod.textContent = visibleBod;
            countStaf.textContent = visibleStaf;

            // Handle empty rows
            const body = document.getElementById('table-body');
            const existingNoData = document.querySelector('.no-data-search-row');
            if (visibleCount === 0 && rows.length > 0) {
                if (!existingNoData) {
                    const tr = document.createElement('tr');
                    tr.className = 'no-data-search-row';
                    tr.innerHTML = `
                        <td colspan="7">
                            <div class="no-data">
                                <i class="fas fa-search"></i>
                                Tidak ditemukan hasil pencocokan untuk "${searchInput.value}"
                            </div>
                        </td>
                    `;
                    body.appendChild(tr);
                }
            } else if (existingNoData) {
                existingNoData.remove();
            }
        }

        searchInput.addEventListener('input', filterTable);
        filterSelect.addEventListener('change', filterTable);

        // Lightbox function
        function openLightbox(url, name, division, type, time) {
            const lightbox = document.getElementById('lightbox');
            document.getElementById('lightbox-img').src = url;
            document.getElementById('lightbox-name').textContent = name;
            document.getElementById('lightbox-meta').innerHTML = `
                <span class="badge ${type.toLowerCase()}" style="padding: 2px 8px; font-size: 0.75rem;">${type}</span> • 
                <span class="divisi-badge" style="padding: 2px 8px; font-size: 0.75rem;">${division}</span> • 
                <span style="font-size: 0.85rem;">${time}</span>
            `;
            lightbox.style.display = 'flex';
        }

        function closeLightbox() {
            document.getElementById('lightbox').style.display = 'none';
        }

        // Handle Escape key to close lightbox
        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') closeLightbox();
        });

        // Delete submission function
        async function deleteSubmission(id) {
            if (!confirm('Apakah Anda yakin ingin menghapus data pendaftaran ini secara permanen dari server?')) return;

            try {
                const response = await fetch(`/api/submissions/${id}`, {
                    method: 'DELETE'
                });

                const data = await response.json();

                if (data.success) {
                    // Temukan baris tabel dan buat animasi fade-out
                    const row = document.querySelector(`tr[data-id="${id}"]`);
                    if (row) {
                        row.style.transition = 'all 0.5s ease';
                        row.style.opacity = '0';
                        row.style.transform = 'translateX(-20px)';
                        
                        setTimeout(() => {
                            row.remove();
                            // Refresh metrics & table filter
                            location.reload(); 
                        }, 500);
                    }
                } else {
                    alert('Gagal menghapus data: ' + data.message);
                }
            } catch (err) {
                console.error('Error deleting submission:', err);
                alert('Terjadi kesalahan saat menghapus data.');
            }
        }

        // Export to real Excel file (XLSX, NOT CSV) using SheetJS
        function exportToExcel() {
            // Collect rows currently visible in the table for high accuracy (excludes hidden ones by default, or gets all)
            const exportData = [];
            let index = 1;

            rows.forEach((row) => {
                // If it is visible, include it in the report
                if (row.style.display !== 'none') {
                    const id = row.getAttribute('data-id');
                    const name = row.querySelector('td:nth-child(3)').textContent.trim();
                    const division = row.querySelector('.divisi-badge').textContent.trim();
                    const typeBadge = row.querySelector('.badge');
                    const type = typeBadge.classList.contains('bod') ? 'BOD' : 'Staf';
                    const timestamp = row.querySelector('td:nth-child(6)').textContent.trim();
                    const imgUrl = row.querySelector('.photo-thumbnail').src;

                    exportData.push({
                        "No": index++,
                        "ID Registrasi": id,
                        "Nama Lengkap": name,
                        "Divisi": division,
                        "Kategori (Tipe)": type,
                        "Waktu Registrasi": timestamp,
                        "URL Foto": imgUrl
                    });
                }
            });

            if (exportData.length === 0) {
                alert('Tidak ada data untuk diexport!');
                return;
            }

            // Create workbook and worksheet
            const ws = XLSX.utils.json_to_sheet(exportData);

            // Styling column widths for beautifully formatted excel sheet
            const colWidths = [
                { wch: 6 },   // No
                { wch: 18 },  // ID Registrasi
                { wch: 25 },  // Nama Lengkap
                { wch: 18 },  // Divisi
                { wch: 15 },  // Kategori (Tipe)
                { wch: 25 },  // Waktu Registrasi
                { wch: 60 }   // URL Foto
            ];
            ws['!cols'] = colWidths;

            const wb = XLSX.utils.book_new();
            XLSX.utils.book_append_sheet(wb, ws, "Daftar Registrasi");

            // Generate filename based on date
            const dateStr = new Date().toISOString().slice(0, 10);
            const filename = `Data_Registrasi_SynchroMark_${dateStr}.xlsx`;

            // Download file
            XLSX.writeFile(wb, filename);
        }

        // Add new division
        async function addDivision() {
            const input = document.getElementById('new-division-name');
            const name = input.value.trim();

            if (!name) {
                alert('Silahkan masukkan nama divisi!');
                return;
            }

            try {
                const response = await fetch('/api/divisions', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ name })
                });

                const data = await response.json();

                if (data.success) {
                    // Refresh divisi di halaman secara instan
                    const container = document.getElementById('division-list-container');
                    const div = document.createElement('div');
                    div.className = 'division-item';
                    div.setAttribute('data-name', name);
                    div.innerHTML = `
                        <span class="div-name">${name}</span>
                        <button class="btn-delete-div" title="Hapus Divisi" onclick="deleteDivision('${name}')">
                            <i class="fas fa-times"></i>
                        </button>
                    `;
                    container.appendChild(div);
                    input.value = '';
                    
                    // Otomatis reload agar form & dropdown sinkron jika sedang dibuka di tab lain
                    location.reload(); 
                } else {
                    alert('Gagal menambah divisi: ' + data.message);
                }
            } catch (err) {
                console.error('Error adding division:', err);
                alert('Terjadi kesalahan saat menambah divisi.');
            }
        }

        // Delete active division
        async function deleteDivision(name) {
            if (!confirm(`Apakah Anda yakin ingin menghapus divisi "${name}" dari daftar aktif?`)) return;

            try {
                const response = await fetch(`/api/divisions/${encodeURIComponent(name)}`, {
                    method: 'DELETE'
                });

                const data = await response.json();

                if (data.success) {
                    const item = document.querySelector(`.division-item[data-name="${name}"]`);
                    if (item) {
                        item.style.transition = 'all 0.4s ease';
                        item.style.opacity = '0';
                        item.style.transform = 'translateY(10px)';
                        setTimeout(() => {
                            item.remove();
                            location.reload();
                        }, 400);
                    }
                } else {
                    alert('Gagal menghapus divisi: ' + data.message);
                }
            } catch (err) {
                console.error('Error deleting division:', err);
                alert('Terjadi kesalahan saat menghapus divisi.');
            }
        }
    </script>
</body>

</html>
